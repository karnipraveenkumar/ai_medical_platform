# Example environment variables for AI Medical Platform backend
# Copy this file to `.env` and update values for your environment.

# Database connection URL (Postgres example):
#   postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:admin123@localhost:5432/ai_medical_db

# Application secret used to sign JWTs. Change to a secure random value in production.
SECRET_KEY=change-me-to-a-secure-random-value

# JWT signing algorithm
ALGORITHM=HS256

# Token expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Groq API key (recommended environment variable name)
GROQ_API_KEY=change-me-to-your-groq-api-key

# Optional: custom Groq API base URL
GROQ_API_BASE_URL=https://api.groq.ai/v1
